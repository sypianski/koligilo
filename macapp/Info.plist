<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>koligilo</string>
	<key>CFBundleDisplayName</key><string>koligilo</string>
	<key>CFBundleIdentifier</key><string>ski.sypian.koligilo</string>
	<key>CFBundleExecutable</key><string>koligilo-app</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>@VERSION@</string>
	<key>CFBundleVersion</key><string>@BUILD@</string>
	<key>CFBundleDevelopmentRegion</key><string>pl</string>
	<key>LSMinimumSystemVersion</key><string>13.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSHumanReadableCopyright</key><string>koligilo — ustawienia KOReadera te same na wszystkich czytnikach</string>
	<!-- panel to http://127.0.0.1 — bez tego ATS blokuje ładowanie w WKWebView -->
	<key>NSAppTransportSecurity</key>
	<dict><key>NSAllowsLocalNetworking</key><true/></dict>
	<!-- czytniki w tej samej sieci: API :7210 i discovery UDP :47470 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>koligilo odpowiada czytnikom w tej samej sieci Wi-Fi, żeby mogły się z nim połączyć bez wpisywania adresu.</string>
</dict>
</plist>
